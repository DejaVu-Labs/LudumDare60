<Project>

  <!--
    Central package management: every version lives here, project files reference packages without versions.
    Analyzers in GlobalPackageReference apply to every project in the repository.
  -->

  <ItemGroup Label="Analyzers">
    <GlobalPackageReference Include="Meziantou.Analyzer" Version="3.0.303" />
  </ItemGroup>

  <ItemGroup Label="Engine">
    <PackageVersion Include="StbImageSharp" Version="2.30.16" />
  </ItemGroup>

  <ItemGroup Label="Desktop platform">
    <!-- SDL3-CS is the managed wrapper; the per-OS packages carry the native SDL3 libraries. Keep all four in step. -->
    <PackageVersion Include="SDL3-CS" Version="3.4.18" />
    <PackageVersion Include="SDL3-CS.Linux" Version="3.4.18" />
    <PackageVersion Include="SDL3-CS.MacOS" Version="3.4.18" />
    <PackageVersion Include="SDL3-CS.Windows" Version="3.4.18" />
    <!-- Managed Ogg Vorbis decoder for the desktop audio backend (SDL decodes only WAV). -->
    <PackageVersion Include="NVorbis" Version="0.10.5" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3.mtp-v2" Version="4.0.2" />
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- shaderc, to compile the desktop platform's GLSL shaders to SPIR-V (DesktopShaderTests). -->
    <PackageVersion Include="Silk.NET.Shaderc" Version="2.23.0" />
    <PackageVersion Include="Silk.NET.Shaderc.Native" Version="2.23.0" />
  </ItemGroup>

</Project>
